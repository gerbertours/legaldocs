{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\template-processor.ts",
            "args": [
                "--template", "privacy-policy--*.md",
            ],
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug with Marketing Template Filter",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\template-processor.ts",
            "args": [
                "--template", "privacy-policy--marketing-site.md",
                "--filter", "GT,CT"
            ],
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug with Both Templates",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\template-processor.ts",
            "args": [
                "--template", "privacy-policy--accounts-site.md",
                "--template", "privacy-policy--marketing-site.md",
                "--filter", "GT,CT,ACT"
            ],
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Validate Only",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\template-processor.ts",
            "args": [
                "--template", "privacy-policy--accounts-site.md",
                "--template", "privacy-policy--marketing-site.md",
                "--validate"
            ],
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ]
        }
    ]
}